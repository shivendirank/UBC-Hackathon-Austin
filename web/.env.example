# Browser talks to same-origin /backend on Vercel (see app/backend/[...path]/route.ts).
# Locally, point straight at the FastAPI process.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side proxy target: public HTTPS URL of the Thin Ice API (ngrok/cloudflare tunnel).
# Required on Vercel. Example: https://xxxx.ngrok-free.app
THIN_ICE_API_URL=

# ElevenLabs orb — server-only on Vercel (Project → Settings → Environment Variables).
# Do NOT prefix with NEXT_PUBLIC_. Copy from backend/.env for the demo.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Optional Picovoice wake word (leave blank to use browser SpeechRecognition).
NEXT_PUBLIC_PICOVOICE_ACCESS_KEY=
NEXT_PUBLIC_PICOVOICE_KEYWORD_PATH=
NEXT_PUBLIC_PICOVOICE_MODEL_PATH=
