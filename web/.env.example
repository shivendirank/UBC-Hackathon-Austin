# Browser talks to same-origin /backend on Vercel (see next.config.ts rewrites).
# Locally, point straight at the FastAPI process.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side / rewrite target: public HTTPS URL of the Thin Ice API (Cloudflare/ngrok tunnel).
# Required on Vercel. Example: https://xxxx.trycloudflare.com
THIN_ICE_API_URL=

# Optional Picovoice wake word (leave blank to use browser SpeechRecognition).
NEXT_PUBLIC_PICOVOICE_ACCESS_KEY=
NEXT_PUBLIC_PICOVOICE_KEYWORD_PATH=
NEXT_PUBLIC_PICOVOICE_MODEL_PATH=
