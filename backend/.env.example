# Copy to backend/.env. Never commit .env or keypairs.
# Gemini public endpoints need no key.
REQUESTS_PER_SECOND=0.95
WATCHLIST_MAX=200
# Comma-separated instrument symbols streamed every second over WebSocket (demo markets)
DEMO_SYMBOLS=
DB_PATH=data/thin_ice.db
SNAPSHOT_DIR=data/snapshots
SNAPSHOT_BASE_URI=http://localhost:8000/api/snapshots

# Solana devnet (fill in after `anchor deploy`)
SOLANA_RPC=https://api.devnet.solana.com
ODDS_RECEIPT_PROGRAM_ID=
RECEIPT_AUTHORITY_KEYPAIR=

# Required to mint receipts through POST /api/markets/{symbol}/receipt
ADMIN_TOKEN=change-me
CORS_ORIGINS=http://localhost:3000

# Consistency engine
FEE_CENTS_PER_CONTRACT=0
SYNC_TOLERANCE_S=120

# Grok Bot Sentinel (routine webhook; leave blank to skip)
GROK_ROUTINE_WEBHOOK=
GROK_ROUTINE_TOKEN=
PUBLIC_API_URL=http://localhost:8000
